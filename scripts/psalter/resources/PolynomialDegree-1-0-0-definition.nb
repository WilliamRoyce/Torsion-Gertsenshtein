Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PolynomialDegree", "[", 
    RowBox[{"0", ",", "varlist_"}], "]"}], ":=", "Undefined"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PolynomialDegree", "[", 
    RowBox[{"poly_", ",", "varslist_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"epoly", "=", 
       RowBox[{"Expand", "[", "poly", "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"PolynomialQ", "[", 
          RowBox[{"epoly", ",", "varslist"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"Poly", "::", "notpoly"}], ",", "poly", ",", "varslist"}], 
          "]"}], ";", 
         RowBox[{"Return", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "epoly", "]"}], "=!=", "Plus"}], ",", 
        RowBox[{"Plus", "@@", 
         RowBox[{"Exponent", "[", 
          RowBox[{"epoly", ",", "varslist"}], "]"}]}], ",", 
        RowBox[{"Max", "@", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Plus", "@@", 
              RowBox[{"Exponent", "[", 
               RowBox[{"#", ",", "varslist"}], "]"}]}], ")"}], "&"}], ",", 
           RowBox[{"Level", "[", 
            RowBox[{"epoly", ",", "1"}], "]"}]}], "]"}]}]}], "]"}]}]}], 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Poly", "::", "notpoly"}], "=", 
   "\"\<The input expression `1` is not a polynomial in the specified \
variable(s) `2`.\>\""}], ";"}]}], "Input",
 InitializationCell->True,
 CellEventActions->{Inherited, {"KeyDown", "\t"} :> Replace[SelectionMove[
       SelectedNotebook[], After, Cell]; NotebookFind[
