 CellID->754506620],

Cell[TextData[{
 "A constant polynomial has degree 0 but the zero polynomial (even though it \
is a constant polynomial) does not have a degree (Some authors assign it to \
have degree ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontFamily->"Source Sans Pro"],
 " or ",
 Cell[BoxData[
  RowBox[{"-", "\[Infinity]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro"],
