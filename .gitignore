.venv
.ruff_cache
__pycache__/
*.egg-info/
# setuptools' in-tree build scratch and the wheel/sdist output, both produced by
# `uv build` -- which M0 (#524) makes a routine thing to run.
build/
dist/
third_party/
# Named explicitly under the blanket above, because both are large, generated, and easy to
# add by accident -- and because the blanket may plausibly be narrowed later (it also covers
# a 1.75 GB Wolfram Engine installer).
#   psalter_reference/ -- the upstream PSALTer working tree, installed by
#     scripts/install-psalter.sh at a pinned commit; reproducible, never edited in place.
#   psalter_runs/      -- Tier-1 gate run directories (logs, .mx, checkpoints, spectrograph
#     PDFs).  Anything that must survive is copied into docs/cosmology/evidence/ deliberately.
third_party/psalter_reference/
third_party/psalter_runs/

phd-application-context.md

# examples/data: ignore sim output subdirs but keep theory JSONs
/examples/data/*
!/examples/data/*.json
!/examples/data/README.md

*.png
!docs/figures/*.png
/outputs/

importtime.log
wolfram_test_output.txt
.coverage
.coverage.*

.claude-memory-backup/
.claude-plans-backup/
.claude-project-backup/
.claude-session-context/

.claude/settings.local.json

# Build artifacts
docs/build/
coverage.xml
htmlcov/

# Wolfram installers / license artifacts (never commit)
Wolfram*.sh
Wolfram*.run
Wolfram*.tgz
*.mathpass
.Wolfram*
.WolframEngine*

# Literature — local arXiv TeX sources (large, not for VCS).
# The README inventory is tracked so it travels with the repo; the sources are not.
literature/*
!literature/README.md

# HPC shuttle
scripts/.hpc_jobs
hpc_results/*

# LaTeX build artifacts (generated by latexmk/pdflatex — never commit)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.nav
*.snm
*.synctex.gz
*.toc
*.vrb
*.log
# Scoped to docs/ and research/ to avoid conflicts with other project *.log/*.out usage
docs/**/*.log
docs/**/*.out
research/*.log
research/*.out
# LaTeX-generated PDFs (theme PDFs in docs/talks/.../theme/ are source files, already tracked)
docs/tex/*.pdf
docs/talks/*/*.pdf
docs/figures/*.pdf
research/*.pdf

psalter.tar.gz
TensorTheory_unitarity_deep_classified.pdf
scripts/bibaudit/cache/

CV
